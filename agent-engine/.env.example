# WhatsApp Agent Platform - Environment Variables
# Copy this file to .env and fill in your values

# LLM: Groq (fast cloud inference)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq

# Ollama (local, offline fallback)
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite+aiosqlite:///./wap.db
REDIS_URL=redis://localhost:6379/0

# ChromaDB (for document search)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# WhatsApp Bridge
WHATSAPP_BRIDGE_URL=http://localhost:3001
WA_BRIDGE_SECRET=your_bridge_secret_here

# Razorpay (test mode keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Figma API Token (from Figma account settings)
FIGMA_API_TOKEN=
FIGMA_FILE_KEY=

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=your_jwt_secret_here

# Server
HOST=0.0.0.0
PORT=8000