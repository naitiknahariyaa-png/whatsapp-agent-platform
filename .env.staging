# ──────────────────────────────────────────────────────────────────────
# Staging Environment — Separate DB, Separate WhatsApp Number
# ──────────────────────────────────────────────────────────────────────

# Database (Staging)
POSTGRES_STAGING_DB=whatsapp_agent_staging
POSTGRES_STAGING_USER=wap_staging
POSTGRES_STAGING_PASSWORD=change_me_staging
POSTGRES_STAGING_HOST=postgres_staging
POSTGRES_STAGING_PORT=5432

# Redis (Staging uses DB 1)
REDIS_URL=redis://redis:6379/1

# ChromaDB (shared, but separate collection namespaces via client_id)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# WhatsApp Bridge (Staging — SEPARATE WhatsApp number)
WHATSAPP_BRIDGE_STAGING_URL=http://bridge_staging:3001
WA_BRIDGE_SECRET=change_me_secure_random_string_2026

# API
AGENT_API_STAGING_URL=http://backend_staging:8000
JWT_SECRET_KEY=change_me_very_long_random_string_min_32_chars

# LLM (Use cheaper models in staging)
LLM_PROVIDER=groq
LLM_MODEL=groq/llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://host.docker.internal:11434

# LLM Routing (Aggressive cost savings in staging)
CHEAP_MODEL=groq/llama-3.1-8b-instant
EXPENSIVE_MODEL=groq/llama-3.1-8b-instant
CLASSIFICATION_MODEL=groq/llama-3.1-8b-instant
PLANNING_MODEL=groq/llama-3.1-8b-instant
GENERATION_MODEL=groq/llama-3.1-8b-instant

# Rate Limits (More aggressive in staging)
OUTBOUND_DAILY_CAP=100
OUTBOUND_COOLDOWN_SECONDS=600
OUTBOUND_MIN_DELAY=10.0
OUTBOUND_MAX_DELAY=30.0

# Environment
ENVIRONMENT=staging
PYTHONUNBUFFERED=1

# Staging-specific flags
ENABLE_DEBUG_LOGGING=true
ENABLE_MOCK_EXTERNAL_APIS=false
ENABLE_COST_LOGGING=true