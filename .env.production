# ──────────────────────────────────────────────────────────────────────
# Production Environment
# ──────────────────────────────────────────────────────────────────────

# Database
POSTGRES_DB=whatsapp_agent
POSTGRES_USER=wap_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# WhatsApp Bridge
WHATSAPP_BRIDGE_URL=http://bridge:3001
WA_BRIDGE_SECRET=change_me_secure_random_string_2026

# API
AGENT_API_URL=http://backend:8000
JWT_SECRET_KEY=change_me_very_long_random_string_min_32_chars

# LLM
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://host.docker.internal:11434

# LLM Routing (Cost Optimization)
CHEAP_MODEL=groq/llama-3.1-8b-instant
EXPENSIVE_MODEL=groq/llama-3.3-70b-versatile
CLASSIFICATION_MODEL=groq/llama-3.1-8b-instant
PLANNING_MODEL=groq/llama-3.3-70b-versatile
GENERATION_MODEL=groq/llama-3.3-70b-versatile

# Rate Limits
OUTBOUND_DAILY_CAP=1000
OUTBOUND_COOLDOWN_SECONDS=300
OUTBOUND_MIN_DELAY=5.0
OUTBOUND_MAX_DELAY=20.0

# Environment
ENVIRONMENT=production
PYTHONUNBUFFERED=1